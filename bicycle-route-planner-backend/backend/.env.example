# ========================================================
# Bicycle Route Planner - Backend Environment Variables
# Copy this file to .env and configure the required keys
# ========================================================

# Database Configuration (PostgreSQL / PostGIS)
DB_USER=postgres
DB_PASSWORD=your_secure_database_password
DB_NAME=bicycle_route_planner

# JWT Security & Authorization (min. 32 characters / 256 bits)
JWT_SECRET=your_secure_jwt_secret_minimum_32_characters_or_64_hex_digits

# OpenRouteService External API Key (required for route calculations)
# Obtain a free API key at: https://openrouteservice.org/dev/#/signup
ORS_API_KEY=your_openrouteservice_api_key
